# AgentReceipt Configuration

# API Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_PATH=./data/agentreceipt.sqlite

# GenLayer Network Configuration
# Supported chains: localnet | studionet | testnetBradbury | testnetAsimov
GENLAYER_NETWORK=studionet
GENLAYER_RPC_URL=https://studio.genlayer.com/api
GENLAYER_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional Private Key for Server-side Intelligent Contract Operator (leave empty for demo / browser signer)
GENLAYER_OPERATOR_PRIVATE_KEY=

# Mode: 'demo' (mock validator / simulation) or 'live' (real GenLayer network)
APP_MODE=demo
